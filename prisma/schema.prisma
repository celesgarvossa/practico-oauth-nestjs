generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id Int      @id @default(autoincrement())
  email String   @unique // un solo usuario por email (evita cuentas duplicadas)
  firstName String?
  lastName String?
  picture String? // URL de la foto de perfil de Google
  googleId String?  @unique // null si el usuario se registró de forma local
  password String? // solo para registro local; null en usuarios de Google
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}